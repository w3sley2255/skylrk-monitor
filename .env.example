# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# In GitHub Actions, set these as encrypted repository secrets instead.

# ---- Telegram (recommended default channel) ----
TELEGRAM_BOT_TOKEN=your-bot-token-from-BotFather
TELEGRAM_CHAT_ID=your-numeric-chat-id

# ---- Discord (alternative) ----
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# ---- Email/SMTP (alternative) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=app-password-not-your-login-password
# EMAIL_FROM=you@example.com
# EMAIL_TO=you@example.com
